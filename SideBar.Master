<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SideBar.master.cs" Inherits="TaskQuest.SideBar" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="assets/css/fonts.css" />
    
              <asp:ContentPlaceHolder ID="HeaderContent" runat="server" />

    <link rel="stylesheet" href="assets/css/sidebar.css"/>

</head>
<body>
  <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" />
    <div id="layout">
      <div id="sidebar">
          <!-- Sidebar HTML -->


          <div class="sidebar">

    <!-- Logo -->
    <div class="logo">
        <a href="Default.aspx">
            <img src="assets/img/logo/logo.png" alt="logo">
        </a>
    </div>

    <!-- Main Menu -->
    <ul class="menu">

        <li id="liDashboard" runat="server">
            <a href="Dashboard.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/grid.svg" class="icon">
                <span>Dashboard</span>
            </a>
        </li>

        <li id="liTasks" runat="server">
            <a href="Tasks.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/calendar.svg" class="icon">
                <span>Tasks</span>
            </a>
        </li>


        <li id="liTeams" runat="server">
            <a href="Teams.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/users.svg" class="icon">
                <span>Teams</span>
            </a>
        </li>

        <!-- Active Item -->
        <li id="liProjects" runat="server">
            <a href="Projects.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/folder.svg" class="icon">
                <span>Projects</span>
            </a>
        </li>

    </ul>

    <!-- PROJECT LIST -->
    <div class="task-section" id="taskSection" runat="server" visible="false">
        <div class="project-header">
            <span>TASKS</span>
            <button class="add-btn" onclick="return false;">+</button>
        </div>
        <ul class="project-list">
            <li>
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/check-circle.svg" class="project-img" style="width: 20px; height: 20px; border-radius: 0;">
                <span>Done</span>
                <span class="count count-blue">8</span>
            </li>
            <li>
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/loader.svg" class="project-img" style="width: 20px; height: 20px; border-radius: 0;">
                <span>To Do</span>
                <span class="count count-green">7</span>
            </li>
            <li>
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/clock.svg" class="project-img" style="width: 20px; height: 20px; border-radius: 0;">
                <span>Overdue</span>
                <span class="count count-red">2</span>
            </li>
        </ul>
    </div>

    <div class="project-section" id="projectSection" runat="server">
        <div class="project-header">
            <span>PROJECTS</span>
            <button class="add-btn" onclick="handleCreateProject(); return false;">+</button>
        </div>

        <script>
            function handleCreateProject() {
                // Check if we are on Projects.aspx (ignoring query strings)
                if (window.location.pathname.toLowerCase().indexOf('projects.aspx') !== -1) {
                    if (typeof openProjectModal === 'function') {
                        openProjectModal();
                    }
                } else {
                    window.location.href = 'Projects.aspx?action=create';
                }
            }
        </script>

        <ul class="project-list">
            <asp:UpdatePanel ID="upSideBarProjects" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false">
                <ContentTemplate>
                    <asp:Repeater ID="rptSideBarProjects" runat="server">
                        <ItemTemplate>
                            <li>
                                <img src='<%# Eval("ProjectLogo") %>' class="project-img" onerror="this.src='assets/images/projectTestAvatar.jpg'">
                                <span><%# Eval("ProjectName") %></span>
                            </li>
                        </ItemTemplate>
                    </asp:Repeater>
                </ContentTemplate>
            </asp:UpdatePanel>
        </ul>
    </div>

    <!-- TEAM LIST -->
    <div class="team-section" id="teamSection" runat="server" visible="false">
        <div class="team-header">
            <span>TEAMS</span>
            <button class="add-btn" onclick="if(typeof showCreateTeamModal === 'function') showCreateTeamModal(); else window.location.href='Teams.aspx'; return false;">+</button>
        </div>

        <ul class="team-list">
            <asp:UpdatePanel ID="upSideBarTeams" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false">
                <ContentTemplate>
                    <asp:Repeater ID="rptSideBarTeams" runat="server">
                        <ItemTemplate>
                            <li>
                                <img src='<%# !string.IsNullOrEmpty(Eval("LogoPath") as string) ? Eval("LogoPath") : "assets/images/teamwork.png" %>' class="project-img" style="border-radius: 6px; object-fit: cover;">
                                <span><%# Eval("TeamName") %></span>
                            </li>
                        </ItemTemplate>
                    </asp:Repeater>
                </ContentTemplate>
            </asp:UpdatePanel>
        </ul>
    </div>

    <!-- Profile -->
    <div class="profile" style="cursor: default;">
        <div onclick="openProfileModal();" style="display: flex; align-items: center; gap: 10px; cursor: pointer; flex-grow: 1;">
            <asp:Image ID="imgProfileAvatar" runat="server" CssClass="avatar" ImageUrl="assets/images/default-avatar.png" />
            <div class="profile-info">
                <asp:Label ID="lblProfileName" runat="server" CssClass="name" Text="Guest User"></asp:Label>
                <span class="role">User</span>
            </div>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/settings.svg" class="settings-icon" onclick="openProfileModal();" style="cursor: pointer;" title="Settings">
            <a href="Logout.aspx" title="Logout (Exit)" style="display: flex; align-items: center;">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/log-out.svg" class="settings-icon" style="color: #dc3545; filter: invert(27%) sepia(51%) saturate(2878%) hue-rotate(346deg) brightness(104%) contrast(97%);" title="Logout">
            </a>
        </div>
    </div>

</div>
      </div>
      <div id="main">
          <!-- Search Bar in ASP.NET WebForms -->
<div class="search-bar">
    <asp:TextBox ID="txtSearch" runat="server" CssClass="search-input" placeholder="Search"></asp:TextBox>
    <asp:LinkButton ID="btnSearch" runat="server" CssClass="search-btn" OnClick="btnSearch_Click">
        <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/search.svg" class="search-icon" alt="Search" />
    </asp:LinkButton>
</div>

          <asp:ContentPlaceHolder ID="MainContent" runat="server" />
      </div>
    </div>

    <!-- Profile Modal -->
    <div id="profileModal" class="modal-overlay">
        <div class="modal-content">
            <span class="modal-close" onclick="closeProfileModal()">&times;</span>
            <iframe id="profileFrame" class="modal-iframe"></iframe>
        </div>
    </div>

    <!-- Session Timeout Warning Modal -->
    <div id="sessionWarningModal" class="modal-overlay" style="display:none; z-index: 10001;">
        <div class="modal-content" style="text-align:center; max-width:400px; padding: 30px; border-radius: 16px;">
            <h3 style="margin-top:0; color: #333;">Inactivity Alert</h3>
            <p style="color: #666; margin: 15px 0;">Your session will expire in 30 seconds due to inactivity.</p>
            <button onclick="resetSessionTimer(); closeSessionWarning(); return false;" style="background-color: #08A0F7; color: white; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 14px;">I'm still here</button>
        </div>
    </div>

    <script>
        // Session Timeout Logic (5 Minutes)
        (function() {
            var time;
            var warningTimer;
            // 5 minutes = 300,000 ms
            var logoutDuration = 5 * 60 * 1000; 
            // Warning at 4:30 = 270,000 ms
            var warningDuration = 4.5 * 60 * 1000; 

            function logout() {
                window.location.href = 'Logout.aspx';
            }

            function showWarning() {
                var modal = document.getElementById('sessionWarningModal');
                if (modal) modal.style.display = 'flex';
            }

            function resetTimer() {
                clearTimeout(time);
                clearTimeout(warningTimer);

                // Start timers
                warningTimer = setTimeout(showWarning, warningDuration);
                time = setTimeout(logout, logoutDuration);
            }

            // Expose globally
            window.resetSessionTimer = resetTimer;
            window.closeSessionWarning = function() {
                document.getElementById('sessionWarningModal').style.display = 'none';
                resetTimer();
            };

            // Reset on activity
            window.onload = resetTimer;
            document.onmousemove = resetTimer;
            document.onkeypress = resetTimer;
            document.onclick = resetTimer;
            document.onscroll = resetTimer;
            document.onmousedown = resetTimer; // Catch clicks too
            document.ontouchstart = resetTimer; // Mobile touches
        })();

        function openProfileModal() {
            var modal = document.getElementById('profileModal');
            var iframe = document.getElementById('profileFrame');
            iframe.src = 'Profile.aspx';
            modal.style.display = 'flex';
        }

        function closeProfileModal() {
            var modal = document.getElementById('profileModal');
            var iframe = document.getElementById('profileFrame');
            modal.style.display = 'none';
            iframe.src = '';
            
            // Reload the parent page to reflect any changes (like avatar)
            // Optional: You might want to do this only if changes were saved
            // window.location.reload(); 
        }
    </script>
  </form>
</body>
</html>