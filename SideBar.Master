<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SideBar.master.cs" Inherits="TaskQuest.SideBar" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="assets/css/fonts.css" />
    
              <asp:ContentPlaceHolder ID="HeaderContent" runat="server" />

    <link rel="stylesheet" href="assets/css/sidebar.css"/>

</head>
<body>
  <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
    <div id="layout">
      <div id="sidebar">
          <!-- Sidebar HTML -->


          <div class="sidebar">

    <!-- Logo -->
    <div class="logo">
        <a href="Default.aspx">
            <img src="assets/img/logo/logo.png" alt="logo">
        </a>
    </div>

    <!-- Main Menu -->
    <ul class="menu">

        <li id="liDashboard" runat="server">
            <a href="Dashboard.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/grid.svg" class="icon">
                <span>Dashboard</span>
            </a>
        </li>

        <li id="liTasks" runat="server">
            <a href="Tasks.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/calendar.svg" class="icon">
                <span>Tasks</span>
            </a>
        </li>


        <li id="liTeams" runat="server">
            <a href="Teams.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/users.svg" class="icon">
                <span>Teams</span>
            </a>
        </li>

        <!-- Active Item -->
        <li id="liProjects" runat="server">
            <a href="Projects.aspx" class="menu-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/folder.svg" class="icon">
                <span>Projects</span>
            </a>
        </li>

    </ul>

    <!-- PROJECT LIST -->
    <div class="project-section" id="projectSection" runat="server">
        <div class="project-header">
            <span>PROJECTS</span>
            <button class="add-btn" onclick="handleCreateProject(); return false;">+</button>
        </div>

        <script>
            function handleCreateProject() {
                // Check if we are on Projects.aspx (ignoring query strings)
                if (window.location.pathname.toLowerCase().indexOf('projects.aspx') !== -1) {
                    if (typeof openProjectModal === 'function') {
                        openProjectModal();
                    }
                } else {
                    window.location.href = 'Projects.aspx?action=create';
                }
            }
        </script>

        <ul class="project-list">
            <asp:UpdatePanel ID="upSideBarProjects" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false">
                <ContentTemplate>
                    <asp:Repeater ID="rptSideBarProjects" runat="server">
                        <ItemTemplate>
                            <li>
                                <img src='<%# Eval("ProjectLogo") %>' class="project-img" onerror="this.src='assets/images/projectTestAvatar.jpg'">
                                <span><%# Eval("ProjectName") %></span>
                            </li>
                        </ItemTemplate>
                    </asp:Repeater>
                </ContentTemplate>
            </asp:UpdatePanel>
        </ul>
    </div>

    <!-- TEAM LIST -->
    <div class="team-section" id="teamSection" runat="server" visible="false">
        <div class="team-header">
            <span>TEAMS</span>
            <button class="add-btn" onclick="if(typeof showCreateTeamModal === 'function') showCreateTeamModal(); else window.location.href='Teams.aspx'; return false;">+</button>
        </div>

        <ul class="team-list">
            <asp:UpdatePanel ID="upSideBarTeams" runat="server" UpdateMode="Conditional" ChildrenAsTriggers="false">
                <ContentTemplate>
                    <asp:Repeater ID="rptSideBarTeams" runat="server">
                        <ItemTemplate>
                            <li>
                                <img src='<%# !string.IsNullOrEmpty(Eval("LogoPath") as string) ? Eval("LogoPath") : "assets/images/teamwork.png" %>' class="project-img" style="border-radius: 6px; object-fit: cover;">
                                <span><%# Eval("TeamName") %></span>
                            </li>
                        </ItemTemplate>
                    </asp:Repeater>
                </ContentTemplate>
            </asp:UpdatePanel>
        </ul>
    </div>

    <!-- Profile -->
    <div class="profile" style="cursor: default;">
        <div onclick="openProfileModal();" style="display: flex; align-items: center; gap: 10px; cursor: pointer; flex-grow: 1;">
            <asp:Image ID="imgProfileAvatar" runat="server" CssClass="avatar" ImageUrl="assets/images/default-avatar.png" />
            <div class="profile-info">
                <asp:Label ID="lblProfileName" runat="server" CssClass="name" Text="Guest User"></asp:Label>
                <span class="role">User</span>
            </div>
        </div>
        <div class="profile-actions">
            <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/settings.svg" class="settings-icon" onclick="openProfileModal();" style="cursor: pointer;" title="Settings">
            <a href="Logout.aspx" title="Logout (Exit)" class="logout-link">
                <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/log-out.svg" class="logout-icon" alt="Logout" />
            </a>
        </div>
    </div>

</div>
      </div>
      <div id="main">
          <!-- Search Bar in ASP.NET WebForms -->
<div class="search-bar">
    <asp:TextBox ID="txtSearch" runat="server" CssClass="search-input" placeholder="Search"></asp:TextBox>
    <asp:LinkButton ID="btnSearch" runat="server" CssClass="search-btn" OnClick="btnSearch_Click">
        <img src="https://cdn.jsdelivr.net/npm/feather-icons/dist/icons/search.svg" class="search-icon" alt="Search" />
    </asp:LinkButton>
</div>

          <asp:ContentPlaceHolder ID="MainContent" runat="server" />
      </div>
    </div>

    <!-- Profile Modal -->
    <div id="profileModal" class="modal-overlay">
        <div class="modal-content">
            <span class="modal-close" onclick="closeProfileModal()">&times;</span>
            <iframe id="profileFrame" class="modal-iframe"></iframe>
        </div>
    </div>

    <!-- Session Timeout Warning Modal -->
    <div id="sessionWarningModal" class="modal-overlay" style="display:none; z-index: 10001;">
        <div class="modal-content" style="text-align:center; max-width:400px; padding: 40px 30px; border-radius: 16px; background: #fff; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
            
            <!-- Icon -->
            <div style="position: relative; width: 60px; height: 60px; margin: 0 auto 20px auto;">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#3d6aff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <!-- Badge Number -->
                <div id="timeoutBadge" style="position: absolute; bottom: -5px; right: -5px; background: #3d6aff; color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; border: 2px solid #fff;">
                    5
                </div>
            </div>

            <h3 style="font-size: 18px; color: #1e1e1e; margin-bottom: 10px; font-weight: 600;">You've been inactive for <span id="inactiveMinutesText">5</span> minutes</h3>
            <p style="color: #666; font-size: 14px; margin-bottom: 25px;">Are you still there?</p>
            
            <button onclick="resetSessionTimer(); closeSessionWarning(); return false;" style="background-color: #3d6aff; color: white; border: none; padding: 12px 0; width: 100%; border-radius: 12px; cursor: pointer; font-size: 14px; font-weight: 600; transition: background 0.2s;">Continue</button>
        </div>
    </div>

    <script>
        // Session Timeout Logic (5 Minutes)
        (function() {
            var time;
            var warningTimer;
            
            // CONFIGURATION: Set your timeout here (in minutes)
            // This should match Web.config sessionState timeout
            var sessionTimeoutMinutes = 5; 
            
            var logoutDuration = sessionTimeoutMinutes * 60 * 1000; 
            
            // Warning 1 minute before timeout
            var warningDuration = (sessionTimeoutMinutes - 1) * 60 * 1000; 

            // Debug Timer Variables
            var lastActivityTime = Date.now();

            function updateDebugTimer() {
                var now = Date.now();
                var inactivity = now - lastActivityTime;
                
                var el = document.getElementById('debugTimer');
                if (el) {
                    var inactivitySec = Math.floor(inactivity / 1000);
                    
                    // Format as MM:SS
                    var minutes = Math.floor(inactivitySec / 60);
                    var seconds = inactivitySec % 60;
                    
                    // Pad with leading zeros
                    var formattedTime = 
                        (minutes < 10 ? "0" + minutes : minutes) + ":" + 
                        (seconds < 10 ? "0" + seconds : seconds);
                        
                    el.innerText = formattedTime;
                }
            }
            
            // Run debug timer every second
            setInterval(updateDebugTimer, 1000);

            function logout() {
                window.location.href = 'Logout.aspx';
            }

            function showWarning() {
                var modal = document.getElementById('sessionWarningModal');
                
                // Update dynamic text
                var inactiveMins = sessionTimeoutMinutes - 1; // e.g. 5 - 1 = 4
                
                // If the user wants the text to say "5" when timeout is 6, logic holds.
                // If user wants "5" when timeout is 5... that means warning is at 5 mins? But then session expires.
                // User said: "number 5 ... is the inactivity time I set, minus one".
                // So if I set 6 mins, number is 5.
                // If I set 5 mins, number is 4.
                
                // Let's ensure the badge and text reflect this "minus one" value.
                document.getElementById('inactiveMinutesText').innerText = inactiveMins;
                document.getElementById('timeoutBadge').innerText = inactiveMins;

                if (modal) modal.style.display = 'flex';
            }

            function resetTimer() {
                clearTimeout(time);
                clearTimeout(warningTimer);

                lastActivityTime = Date.now(); // Update activity timestamp

                // Start timers
                warningTimer = setTimeout(showWarning, warningDuration);
                time = setTimeout(logout, logoutDuration);
            }
                time = setTimeout(logout, logoutDuration);
            }

            // Expose globally
            window.resetSessionTimer = resetTimer;
            window.closeSessionWarning = function() {
                document.getElementById('sessionWarningModal').style.display = 'none';
                resetTimer();
            };

            // Reset on activity
            window.onload = resetTimer;
            document.onmousemove = resetTimer;
            document.onkeypress = resetTimer;
            document.onclick = resetTimer;
            document.onscroll = resetTimer;
            document.onmousedown = resetTimer; // Catch clicks too
            document.ontouchstart = resetTimer; // Mobile touches
        })();

        function openProfileModal() {
            var modal = document.getElementById('profileModal');
            var iframe = document.getElementById('profileFrame');
            iframe.src = 'Profile.aspx';
            modal.style.display = 'flex';
        }

        function closeProfileModal() {
            var modal = document.getElementById('profileModal');
            var iframe = document.getElementById('profileFrame');
            modal.style.display = 'none';
            iframe.src = '';
            
            // Reload the parent page to reflect any changes (like avatar)
            // Optional: You might want to do this only if changes were saved
            // window.location.reload(); 
        }
    </script>
  </form>
</body>
</html>
